[Unit]
Description=KianCode agent service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kiancode
Group=kiancode
WorkingDirectory=/opt/kiancode/current
ExecStart=/usr/bin/node /opt/kiancode/current/dist/cli.js serve --config /etc/kiancode/config.json
Environment=NODE_ENV=production
EnvironmentFile=/etc/kiancode/service.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kiancode /srv/kiancode/workspaces
MemoryMax=1G

[Install]
WantedBy=multi-user.target
